## --- PHẦN BACKEND (.NET / C#) ---
# Thư mục build và biên dịch
[Bb]in/
[Oo]bj/

# Cấu hình người dùng Visual Studio (User-specific)
.vs/
.vscode/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs

# File rác hệ thống & Debug log
*.log
*.dmp
*.stackdump

# NuGet Packages (Chỉ chặn thư mục gói, giữ lại file config)
packages/
!packages/build/
*.nupkg

# SQL Server (Local DB file)
*.mdf
*.ldf

# Các file cấu hình chứa bí mật (Credential) - QUAN TRỌNG
# Chỉ chặn file Development/Local để tránh lộ pass DB, giữ lại file appsettings.json gốc
appsettings.Development.json
appsettings.Local.json

## --- PHẦN FRONTEND (REACTJS / NODEJS) ---
# Thư mục thư viện (Rất nặng - BẮT BUỘC PHẢI CHẶN)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Thư mục build ra sản phẩm (React Vite)
dist/
dist-ssr/
coverage/

# Các file biến môi trường (Chứa API Key, Port...)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

## --- HỆ ĐIỀU HÀNH (OS FILES) ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# MacOS (Nếu team có người dùng Mac)
.DS_Store
.AppleDouble
.LSOverride

## --- KHÁC ---
# Test results
TestResults/
*.trdx

# ReSharper (Nếu dùng JetBrains)
_ReSharper*/
*.ReSharper